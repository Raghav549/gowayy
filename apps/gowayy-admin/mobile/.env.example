# Public URL of the deployed GOWAYY Admin web console (HTTPS required in production).
# The admin APK is a hardened WebView shell: no admin logic or credentials ship inside the binary.
EXPO_PUBLIC_ADMIN_URL=https://admin.gowayy.app

# Use the same backend as the Admin web console for native push RPCs.
EXPO_PUBLIC_GOWAYY_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Real EAS project ID used to request an Expo push token (not a secret).
EXPO_PUBLIC_EAS_PROJECT_ID=

# HTTP development alternative; never use localhost on a physical device.
# EXPO_PUBLIC_GOWAYY_BACKEND=http
# EXPO_PUBLIC_GOWAYY_API_BASE_URL=http://YOUR_LAN_IP:8787/api
