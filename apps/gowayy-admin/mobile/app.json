{
  "expo": {
    "name": "GOWAYY ADMIN",
    "slug": "gowayy-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "gowayyadmin",
    "newArchEnabled": true,
    "icon": "./assets/branding/app-icon.png",
    "splash": {
      "image": "./assets/branding/g-symbol.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1B19"
    },
    "android": {
      "package": "app.gowayy.admin",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon-foreground.png",
        "monochromeImage": "./assets/branding/icon-monochrome.png",
        "backgroundImage": "./assets/branding/icon-background.png"
      },
      "permissions": ["INTERNET", "POST_NOTIFICATIONS"]
    },
    "extra": {
      "accent": "#1C1B19",
      "accentSoft": "#F4EFE6"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/g-symbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C1B19"
        }
      ]
    ]
  }
}
