# GOWAYY development API (apps/dev-api). Copy to .env — never commit .env.
# Port and host (server binds 0.0.0.0 so phones on the LAN can reach it).
PORT=8787

# "development" enables the demo OTP adapter and demo seeding.
# Anything else (or NODE_ENV=production) disables demo seeding.
GOWAYY_ENV=development

# Optional JSON persistence path. Defaults to apps/dev-api/data/db.json.
# GOWAYY_DB_FILE=./data/db.json

# Demo OTP adapter. Do not claim real email delivery in development.
GOWAYY_OTP_PROVIDER=demo

# Sandbox payments. The webhook secret must match the provider/sandbox sender.
GOWAYY_PAYMENT_PROVIDER=sandbox
GOWAYY_WEBHOOK_SECRET=replace-with-a-long-random-string

# Leave blank to keep card/net-banking disabled with HTTP 503 GATEWAY_NOT_CONFIGURED.
# Supplying a key only satisfies the configuration check in this reference API;
# a production gateway adapter still has to be wired to the provider.
GOWAYY_PAYMENT_GATEWAY_KEY=

# Optional: enables the live Supabase adapter path instead of the dev API.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
