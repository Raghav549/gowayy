{
  "name": "@gowayy/partner-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --host 0.0.0.0",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:prod": "eas build --profile production --platform android",
    "update:prod": "eas update --channel production --message \"OTA update\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.2",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^5.6.3"
  }
}