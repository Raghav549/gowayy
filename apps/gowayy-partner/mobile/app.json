{
  "expo": {
    "name": "GOWAYY PARTNER",
    "slug": "gowayy-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "gowayypartner",
    "newArchEnabled": true,
    "icon": "./assets/branding/app-icon.png",
    "splash": {
      "image": "./assets/branding/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#421080"
    },
    "android": {
      "package": "app.gowayy.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon-foreground.png",
        "monochromeImage": "./assets/branding/icon-monochrome.png",
        "backgroundImage": "./assets/branding/icon-background.png"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "extra": {
      "accent": "#421080",
      "accentSoft": "#EDE3F7"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#421080",
          "dark": {
            "image": "./assets/branding/g-symbol.png",
            "backgroundColor": "#421080"
          }
        }
      ]
    ]
  }
}
