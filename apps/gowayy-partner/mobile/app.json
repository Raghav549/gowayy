{
  "expo": {
    "name": "GOWAYY PARTNER",
    "slug": "gowayy-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "gowayypartner",
    "newArchEnabled": true,
    "icon": "./assets/branding/app-icon.png",
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F3FB"
    },
    "android": {
      "package": "app.gowayy.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon-foreground.png",
        "monochromeImage": "./assets/branding/icon-monochrome.png",
        "backgroundImage": "./assets/branding/icon-background.png"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "gowayy-partner"
      },
      "accent": "#421080",
      "accentSoft": "#EDE3F7"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
