{
  "expo": {
    "name": "GOWAYY PARTNER",
    "slug": "gowayy-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "gowayypartner",
    "newArchEnabled": true,
    "icon": "./assets/branding/app-icon.png",
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF4E9"
    },
    "android": {
      "package": "app.gowayy.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon-foreground.png",
        "backgroundColor": "#F8E3D8",
        "monochromeImage": "./assets/branding/icon-monochrome.png"
      },
      "permissions": ["INTERNET", "POST_NOTIFICATIONS"]
    },
    "extra": {
      "eas": { "projectId": "gowayy-partner" },
      "accent": "#C2502A",
      "accentSoft": "#F8E3D8"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
