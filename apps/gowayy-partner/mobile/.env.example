# GOWAYY PARTNER (Android) — environment. Copy to .env and fill in.
# Never commit real values. The app never embeds service-role keys.
EXPO_PUBLIC_GOWAYY_BACKEND=http          # http = dev-api, supabase = Edge gateway
EXPO_PUBLIC_GOWAYY_API_BASE_URL=http://YOUR_LAN_IP:8787/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Real EAS project ID used to request an Expo push token (not a secret).
EXPO_PUBLIC_EAS_PROJECT_ID=
