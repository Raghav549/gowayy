# Customer web app. Copy to .env.local for local overrides.
# Default is the dev API through the Vite proxy (/api -> 127.0.0.1:8787).
# VITE_API_BASE_URL=/api

# Leave unset (or "dev-api") to use apps/dev-api; set to "supabase" for hosted.
# VITE_GOWAYY_BACKEND=dev-api
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional UPI VPA used to build a upi:// intent in the sandbox checkout.
# This is a display/sandbox convenience, not proof of payment.
# VITE_UPI_VPA=gowayy@examplebank
