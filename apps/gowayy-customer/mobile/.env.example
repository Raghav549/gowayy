# Absolute URL of the GOWAYY API. On a physical Android device localhost does NOT
# work: use the machine's LAN IP or a deployed HTTPS endpoint.
EXPO_PUBLIC_GOWAYY_API_BASE_URL=http://192.168.1.10:8787/api
# Base URL for verified place photographs (the web app's public/ directory).
EXPO_PUBLIC_GOWAYY_ASSET_BASE_URL=http://192.168.1.10:5173

# Production backend selection (optional). Requires a deployed Supabase project.
# EXPO_PUBLIC_GOWAYY_BACKEND=supabase
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
